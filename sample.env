# -------------------------------------------------------------------
# CharFinder - Sample .env file
# Copy to .env and adjust values as needed for your environment.
# -------------------------------------------------------------------

# Environment: DEV, UAT, PROD
CHARFINDER_ENV=DEV

# Log settings
CHARFINDER_LOG_MAX_BYTES=1000000
CHARFINDER_LOG_BACKUP_COUNT=5

# Cache file location (optional override)
CHARFINDER_CACHE_FILE_PATH=data/cache/unicode_name_cache.json

# Fuzzy Match Threshold
CHARFINDER_MATCH_THRESHOLD=0.7

# Normalization Profile
CHARFINDER_NORMALIZATION_PROFILE="aggressive"

# Color output mode (auto, always, never)
CHARFINDER_COLOR_MODE=auto

# Output Show Score
CHARFINDER_SHOW_SCORE=1

# Adding Unicode Index Field 10
UNICODE_DATA_URL=https://www.unicode.org/Public/UCD/latest/ucd/UnicodeData.txt
UNICODE_DATA_FILE_PATH=data/UnicodeData.txt

# Debug: set to 1 to enable verbose .env load diagnostics
CHARFINDER_DEBUG_ENV_LOAD=0

# Fuzzy Hybrid Weights (comma-separated weights that sum to ~1.0)
CHARFINDER_FUZZY_WEIGHTS=simple_ratio:0.00,normalized_ratio:0.00,levenshtein_ratio:0.30,token_sort_ratio:0.10,token_subset_ratio:0.60